# Copy to .env.local for local development. Never commit real values —
# this repository is public.

# ---------- Database (PostgreSQL / Neon) ----------
# All store tables live in the "store" schema (migrations journal: "store_migrations").
# Local development: run `npm run db:dev` and keep this value. The production URL is
# set only in Vercel — never put it here or in .env.local.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54328/manan_dev
DB_POOL_MAX=5

# ---------- App ----------
APP_URL=http://localhost:3200
# >= 32 random characters. Signs nothing visible; keys hashed visitor ids and IP hashes.
SESSION_SECRET=
# "index" lets search engines index the demo store. Anything else = noindex (default).
STORE_INDEXING=noindex
# Where the "back to portfolio" links point.
NEXT_PUBLIC_PORTFOLIO_URL=https://ursgal-digital.vercel.app/portfolio/fashion

# ---------- Owner account (used once by `npm run db:seed`) ----------
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# ---------- Payments: QPay ----------
# mock       = clearly labelled simulation, no money moves (the demo default)
# sandbox    = merchant-sandbox.qpay.mn
# production = merchant.qpay.mn — ALSO requires QPAY_ALLOW_LIVE_PAYMENTS=true
QPAY_MODE=mock
QPAY_ALLOW_LIVE_PAYMENTS=
QPAY_BASE_URL=
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=

# ---------- Admin photo uploads (Cloudinary) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=manan-store

# ---------- Shopping assistant ----------
# With a key the assistant uses OpenAI tool calling over the database tools;
# without one it answers in catalogue mode (deterministic, database only).
OPENAI_API_KEY=
OPENAI_MODEL_ASSISTANT=gpt-4.1-mini
AI_DAILY_BUDGET_USD=1
# off = force catalogue mode even when a key is present
ASSISTANT_AI=

# ---------- Scheduled maintenance ----------
CRON_SECRET=

# ---------- Development ----------
# `next dev` loosens rate limits 20×; "strict" tests the real limits.
RATE_LIMITS=
