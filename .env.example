# Copy to .env.local for local development. Never commit real values —
# this repository is public.

# ---------- Database (PostgreSQL / Neon) ----------
# All store tables live in the "store" schema (migrations journal: "store_migrations").
# Local development: run `npm run db:dev` and keep this value. The production URL is
# set only in Vercel — never put it here or in .env.local.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54328/manan_dev
DB_POOL_MAX=5

# ---------- App ----------
APP_URL=http://localhost:3200
# >= 32 random characters. Signs nothing visible; keys hashed visitor ids and IP hashes.
SESSION_SECRET=
# "index" lets search engines index the demo store. Anything else = noindex (default).
STORE_INDEXING=noindex
# Where the "back to portfolio" links point.
NEXT_PUBLIC_PORTFOLIO_URL=https://ursgal-digital.vercel.app/portfolio/fashion

# ---------- Owner account (used once by `npm run db:seed`) ----------
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# ---------- Payments: QPay ----------
# mock       = clearly labelled simulation, no money moves (the demo default)
# sandbox    = merchant-sandbox.qpay.mn
# production = merchant.qpay.mn — ALSO requires QPAY_ALLOW_LIVE_PAYMENTS=true
QPAY_MODE=mock
QPAY_ALLOW_LIVE_PAYMENTS=
QPAY_BASE_URL=
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=

# ---------- Admin photo uploads (Cloudinary) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=manan-store

# ---------- Shopping assistant ----------
# With a key the assistant uses OpenAI tool calling (behind the fact check) for open
# questions; without one it answers in catalogue mode (deterministic, database only).
# Use a key created for this store, with a monthly limit — never another business's key.
OPENAI_API_KEY=
# Used only when Admin → AI чатбот → Чатботын тохиргоо says "server default" and the model has a
# known price; the admin's choice wins. Default: gpt-4.1-mini.
OPENAI_MODEL_ASSISTANT=gpt-4.1-mini
# Default daily budget until the owner sets one in the admin (0 = AI off).
AI_DAILY_BUDGET_USD=1
# off = force catalogue mode even when a key is present
ASSISTANT_AI=

# ---------- Scheduled maintenance ----------
# Optional. Without it, /api/cron/maintenance runs for Vercel Cron itself (at most once per 20 h).
CRON_SECRET=

# ---------- Development ----------
# `next dev` loosens rate limits 20×; "strict" tests the real limits.
RATE_LIMITS=

# ---- Meta: Messenger and Instagram (optional; server only, never NEXT_PUBLIC_) ----
# The webhook /api/meta/webhook answers 503 until the first four are set. Placeholders only.
# Use the NEW Meta app and this brand's Page — never values from the old, compromised
# Meta account. See docs/META_INTEGRATION.md.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
META_APP_ID=
META_GRAPH_API_VERSION=v25.0
# Replies are generated and logged but only SENT when this is "true".
META_OUTBOUND_ENABLED=false
# Optional: one private reply to comments with a trigger word (price, size, order…).
META_COMMENT_REPLIES_ENABLED=false
META_COMMENT_KEYWORDS=
