{
  "name": "manan-store",
  "version": "0.1.0",
  "private": true,
  "description": "MANAN — fictional premium fashion label: storefront, variant-level inventory, orders, AI shopping assistant and admin dashboard (Ursgal Digital portfolio demonstration).",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --port 3200",
    "build": "next build",
    "start": "next start --port 3200",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "tsx scripts/migrate.ts && tsx scripts/seed.ts",
    "db:dev": "tsx scripts/dev-db.ts",
    "db:backup": "tsx scripts/backup.ts",
    "images:build": "tsx scripts/images/build.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "assistant:smoke": "tsx --conditions=react-server scripts/assistant-smoke.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild": true,
    "unrs-resolver": true,
    "sharp": true,
    "@embedded-postgres/windows-x64": true,
    "@embedded-postgres/darwin-arm64": true,
    "@embedded-postgres/darwin-x64": true,
    "@embedded-postgres/linux-x64": true,
    "@embedded-postgres/linux-arm64": true
  }
}
